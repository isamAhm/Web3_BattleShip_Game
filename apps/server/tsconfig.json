{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@battle-arena/engine": ["../../packages/engine/src/index.ts"],
      "@battle-arena/engine/*": ["../../packages/engine/src/*"]
    }
  },
  "include": ["src"],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}
