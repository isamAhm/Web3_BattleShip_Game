{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@battle-arena/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": ["src"],
  "ts-node": {
    "paths": true
  }
}
