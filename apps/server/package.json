{
  "name": "@wba/server",
  "version": "0.1.0",
  "description": "Backend API, Socket.IO real-time server, workers and chain integrations for Web3 Battle Arena",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "bot": "tsx src/bot.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "worker": "node dist/workers/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@wba/engine": "0.1.0",
    "@wba/shared": "0.1.0",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "mongoose": "^8.10.1",
    "siwe": "^3.0.0",
    "socket.io": "^4.8.1",
    "viem": "2.57.12",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "vitest": "5.0.5"
  }
}
