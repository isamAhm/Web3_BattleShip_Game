{
  "name": "@wba/shared",
  "version": "0.1.0",
  "description": "Shared Zod schemas, types, and event definitions for Web3 Battle Arena",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wba/engine": "0.1.0",
    "zod": "^3.24.2"
  }
}
